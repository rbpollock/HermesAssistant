<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: always dark (assistant overlay look). -->
    <style name="Base.Theme.HermesAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.HermesAssistant" parent="Base.Theme.HermesAssistant">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
