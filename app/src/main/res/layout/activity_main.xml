<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:orientation="vertical">

    <!-- Top half: session chips + scrollable chat history -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sessionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="Sessions"
            android:textColor="#8B93A7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/sessionChipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/sessionChipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/historyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:text="Conversation"
            android:textColor="#8B93A7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom half: assistant panel. FrameLayout so the circular keyboard
         icon can float at the top-right. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <com.example.hermesassistant.StatusRingView
                android:id="@+id/statusRing"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Hermes status" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="#E5E7EB"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/subText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tap to speak · wake word: &quot;Hey Hermes&quot;"
                android:textColor="#8B93A7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/speakButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1E293B"
                android:text="TAP TO SPEAK TO HERMES"
                android:textColor="#E5E7EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Text input row: hidden by default, toggled only by the
                 circular keyboard icon -->
            <LinearLayout
                android:id="@+id/textInputRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/textInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/text_input_background"
                    android:hint="Type a message..."
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#8B93A7"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#1E293B"
                    android:contentDescription="Send message"
                    android:src="@android:drawable/ic_menu_send" />
            </LinearLayout>
        </LinearLayout>

        <!-- Circular keyboard icon, top-right of the bottom section.
             Sized to ~12% of screen width in code. -->
        <ImageButton
            android:id="@+id/typeToggleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_icon_background"
            android:contentDescription="Type a message"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_edit" />
    </FrameLayout>
</LinearLayout>
