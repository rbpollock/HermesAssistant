<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:orientation="vertical">

    <!-- Top spacer pushes the panel into the bottom half of the screen -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom-half assistant panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <com.example.hermesassistant.StatusRingView
            android:id="@+id/statusRing"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="Hermes status" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Ready"
            android:textColor="#E5E7EB"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/subText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tap to speak · wake word: &quot;Hey Hermes&quot;"
            android:textColor="#8B93A7"
            android:textSize="13sp" />

        <Button
            android:id="@+id/speakButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1E293B"
            android:text="TAP TO SPEAK TO HERMES"
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
