<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14"
    android:orientation="vertical">

    <!-- ============================================================
         CHAT SECTION (top): session chips + scrollable history.
         Expands to fill when the listening panel is collapsed.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/chatSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sessionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="Sessions"
            android:textColor="#8B93A7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/sessionChipsScroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="horizontal"
            android:fadeScrollbars="true"
            android:scrollbarSize="3dp"
            android:overScrollMode="ifContentScrolls"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/sessionChipsRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/historyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="Conversation"
            android:textColor="#8B93A7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp" />
        </ScrollView>

        <!-- Text input row: bottom of the chat section so it stays above
             the keyboard (adjustResize). Toggled by the keyboard icon. -->
        <LinearLayout
            android:id="@+id/textInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/text_input_background"
                android:hint="Type a message..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#E5E7EB"
                android:textColorHint="#8B93A7"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle_icon_background"
                android:contentDescription="Send message"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_send" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================
         COLLAPSE/EXPAND BAND (the grip above the listening panel).
         Down chevron collapses the panel (chat fills the screen); the
         band then becomes a SLIM LISTENING STRIP — a one-line status
         and a compact speak button — so the half-window frontend
         survives in miniature. Up chevron re-expands.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/panelCollapseBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E293B"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/panelToggleButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/circle_icon_background"
            android:contentDescription="Collapse / expand assistant panel"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_down" />

        <TextView
            android:id="@+id/panelToggleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Collapse panel"
            android:textColor="#E5E7EB"
            android:textSize="14sp" />

        <!-- Collapsed-only strip contents (visibility toggled in code):
             a one-line status and a compact speak/cancel button. -->
        <TextView
            android:id="@+id/panelStripStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Listening for &quot;Hey Hermes&quot;"
            android:textColor="#8B93A7"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/panelStripSpeakButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/primary_button_background"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="SPEAK"
            android:textColor="#E5E7EB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============================================================
         ASSISTANT PANEL (bottom): the half-window listening frontend.
         Collapsible via the band above. The status ring is the focus;
         the speak button is the primary action.
         ============================================================ -->
    <FrameLayout
        android:id="@+id/assistantPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="20dp">

            <com.example.hermesassistant.StatusRingView
                android:id="@+id/statusRing"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:contentDescription="Hermes status" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="#E5E7EB"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/subText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tap to speak · wake word: &quot;Hey Hermes&quot;"
                android:textColor="#8B93A7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/speakButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/primary_button_background"
                android:text="TAP TO SPEAK TO HERMES"
                android:textColor="#E5E7EB"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Circular keyboard icon, top-right of the assistant panel. -->
        <ImageButton
            android:id="@+id/typeToggleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_icon_background"
            android:contentDescription="Type a message"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_edit" />

        <!-- Gear icon, top-left: opens settings. -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle_icon_background"
            android:contentDescription="Settings"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_preferences" />
    </FrameLayout>
</LinearLayout>
